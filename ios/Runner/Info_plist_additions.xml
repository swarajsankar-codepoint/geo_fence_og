<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ADD THESE KEYS TO YOUR EXISTING ios/Runner/Info.plist
  DO NOT replace your entire Info.plist — just merge these keys in
-->
<plist version="1.0">
    <dict>

        <!-- Location permissions — required for geofencing -->
        <key>NSLocationWhenInUseUsageDescription</key>
        <string>This app needs location access to monitor geofence zones.</string>

        <key>NSLocationAlwaysUsageDescription</key>
        <string>This app needs background location access to send alerts when you enter or exit zones.</string>

        <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
        <string>This app needs location access at all times to monitor geofence zones even when closed.</string>

        <!-- Background modes — required for terminated app geofencing -->
        <key>UIBackgroundModes</key>
        <array>
            <string>location</string>           <!-- CLLocationManager background updates -->
            <string>fetch</string>              <!-- BGAppRefreshTask — mirrors WorkManager periodic -->
            <string>processing</string>         <!-- BGProcessingTask — mirrors OneTimeWorkRequest -->
            <string>remote-notification</string> <!-- Push notifications wakeup -->
        </array>

        <!-- BGTask identifiers — must match GeofenceConfigWorker task IDs -->
        <key>BGTaskSchedulerPermittedIdentifiers</key>
        <array>
            <string>com.example.geo_fencing.config_check</string>
            <string>com.example.geo_fencing.config_refresh</string>
        </array>

    </dict>
</plist>